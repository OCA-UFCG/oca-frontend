# Description: Sample environment variables for the project
# Environment variables

# The URL of the host (e.g., https://oca.lsd.ufcg.edu.br)
export NEXT_PUBLIC_HOST_URL="http://localhost:3000"

# Google Analytics ID (e.g., G-Z0N0RCX00X)
export NEXT_PUBLIC_GA_ID=""

# Google Earth Engine private key (e.g., {"type": "service_account","project_id": "ee-ocaufcg","private_key_id"})
export GEE_PRIVATE_KEY=""

# Contentful credencials
export NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=""
export NEXT_PUBLIC_CONTENTFUL_SPACE=""

# Email credentials for sending emails
export NEXT_PUBLIC_MAIL_APP_PASS=""
export NEXT_PUBLIC_MAIL_APP_USER=""
export NEXT_PUBLIC_MAIL_APP_TO=""
export NEXT_PUBLIC_MAIL_APP_CC=""

# Google reCAPTCHA credentials
export NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
export NEXT_PUBLIC_RECAPTCHA_SECRET_KEY=""

# Croqui — registro dos exports numa planilha via Google Apps Script.
# Todas opcionais: sem elas o croqui usa os fallbacks em
# src/croqui/config/exportSink.ts e funciona normalmente.
#
# São NEXT_PUBLIC_*, ou seja, só existem em build-time. Em produção/beta elas
# não vêm deste .env: são passadas como build-args pelos workflows
# .github/workflows/deploy-beta.yml e deploy-oca.yml, lidas de variáveis/
# secrets cadastradas no GitHub Actions (NEXT_PUBLIC_CROQUI_EXPORT_WEBHOOK_URL
# e NEXT_PUBLIC_CROQUI_RECAPTCHA_SITE_KEY em "vars", NEXT_PUBLIC_CROQUI_EXPORT_TOKEN
# em "secrets"). Se não cadastradas, o Dockerfile.production as recebe vazias
# e o croqui cai nos fallbacks acima sem quebrar.
export NEXT_PUBLIC_CROQUI_EXPORT_WEBHOOK_URL=""
export NEXT_PUBLIC_CROQUI_EXPORT_TOKEN=""

# Croqui — reCAPTCHA v2 (checkbox) do modal de exportação.
# Separada de NEXT_PUBLIC_RECAPTCHA_SITE_KEY (usada pelo ContactForm):
# são chaves diferentes, com segredos em lugares diferentes.
export NEXT_PUBLIC_CROQUI_RECAPTCHA_SITE_KEY=""
